    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from transformers import RobertaModel, RobertaTokenizer\n",
    "from torch.utils.data import DataLoader, Dataset\n",
    "import numpy as np\n",
    "\n",
    "class RoBERTa_FeatureExtractor:\n",
    "    def __init__(self, device='cuda' if torch.cuda.is_available() else 'cpu', batch_size=32):\n",
    "        self.device = device\n",
    "        self.batch_size = batch_size\n",
    "        print(f\"🚀 Initializing RoBERTa Extractor on {self.device}...\")\n",
    "        \n",
    "        self.tokenizer = RobertaTokenizer.from_pretrained(\"roberta-base\")\n",
    "        self.model = RobertaModel.from_pretrained(\"roberta-base\").to(self.device)\n",
    "        self.model.eval() # Freeze for extraction\n",
    "\n",
    "    def extract_bag(self, text_list):\n",
    "        \"\"\"\n",
    "        Input: A list of strings (sentences) from ONE patient/conversation.\n",
    "        Output: A Tensor of shape [N_sentences, 768]\n",
    "        \"\"\"\n",
    "        all_embeddings = []\n",
    "        \n",
    "        # Process in batches to prevent OOM and speed up\n",
    "        for i in range(0, len(text_list), self.batch_size):\n",
    "            batch_texts = text_list[i : i + self.batch_size]\n",
    "            \n",
    "            # Tokenize\n",
    "            encoded_input = self.tokenizer(\n",
    "                batch_texts, \n",
    "                return_tensors='pt', \n",
    "                padding=True, \n",
    "                truncation=True, \n",
    "                max_length=128\n",
    "            ).to(self.device)\n",
    "            \n",
    "            with torch.no_grad():\n",
    "                output = self.model(**encoded_input)\n",
    "            \n",
    "            # [CLS] Token Pooling (Standard for RoBERTa sentence embeddings)\n",
    "            # shape: [batch_size, 768]\n",
    "            batch_embeddings = output.last_hidden_state[:, 0, :]\n",
    "            maximal = batch_embeddings.max()\n",
    "            minimal = batch_embeddings.min()\n",
    "            batch_embeddings = (batch_embeddings-minimal) / (maximal - minimal)\n",
    "            all_embeddings.append(batch_embeddings.cpu())\n",
    "            \n",
    "        if len(all_embeddings) == 0:\n",
    "            return None\n",
    "            \n",
    "        # Concatenate all batches into one Bag\n",
    "        # Final Shape: [Total_Sentences, 768]\n",
    "        return torch.cat(all_embeddings, dim=0)\n",
    "\n",
    "class AudioBagsEmbedded(Dataset):\n",
    "    \"\"\"\n",
    "    Dataset MIL para bolsas de audio -> Mel-espectrograma (dB) -> resize a 28x28.\n",
    "    Mantiene la interfaz del MNISTBags: retorna (xs, y) con:\n",
    "      xs: [bag_size, 1, 28, 28]\n",
    "      y : [1] float32 (0/1 o continuo en [0,1])\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        X_target,\n",
    "        y_target,\n",
    "        bag_size=None,              # si None: usa tamaño natural de la bolsa\n",
    "        sample_rate=16000,\n",
    "        n_mels=64,                  # mel interno (luego se reescala a 28)\n",
    "        n_fft=1024,\n",
    "        hop_length=256,\n",
    "        f_min=0.0,\n",
    "        f_max=None,\n",
    "        normalize_per_instance=True,\n",
    "        device=\"cpu\",\n",
    "    ):\n",
    "        super().__init__()\n",
    "        assert len(X_target) == len(y_target), \"X_target y y_target deben tener misma longitud.\"\n",
    "        self.X = X_target\n",
    "        self.y = y_target\n",
    "        self.bag_size = bag_size\n",
    "        self.sample_rate = sample_rate\n",
    "        self.device = device\n",
    "\n",
    "        # self.mel = torchaudio.transforms.MelSpectrogram(\n",
    "        #     sample_rate=sample_rate,\n",
    "        #     n_fft=n_fft,\n",
    "        #     hop_length=hop_length,\n",
    "        #     n_mels=n_mels,\n",
    "        #     f_min=f_min,\n",
    "        #     f_max=f_max,\n",
    "        #     power=2.0,\n",
    "        # ).to(device)\n",
    "\n",
    "        # self.to_db = torchaudio.transforms.AmplitudeToDB(stype=\"power\").to(device)\n",
    "        self.normalize_per_instance = normalize_per_instance\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.X)\n",
    "\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
    "        bag = self.X[idx]                 # iterable de audios (waveforms o paths)\n",
    "        y = torch.tensor([float(self.y[idx])], dtype=torch.float32, device=self.device)\n",
    "\n",
    "        # Ajuste de tamaño de bolsa (opcional)\n",
    "        if self.bag_size is not None:\n",
    "            if len(bag) >= self.bag_size:\n",
    "                # muestreo aleatorio sin reemplazo\n",
    "                sel = torch.randperm(len(bag))[: self.bag_size].tolist()\n",
    "                bag_items = [bag[i] for i in sel]\n",
    "            else:\n",
    "                # relleno con reemplazo\n",
    "                sel = torch.randint(0, len(bag), (self.bag_size,)).tolist()\n",
    "                bag_items = [bag[i] for i in sel]\n",
    "        else:\n",
    "            bag_items = list(bag)\n",
    "\n",
    "        if self.normalize_per_instance:\n",
    "            bag_items = [((S28 - S28.min()) / (S28.max() - S28.min() + 1e-6) * 255.0) for S28 in bag_items]\n",
    "            # bag_items = [((S28 - S28.mean()) / S28.std().clamp_min(1e-6) ) for S28 in bag_items]\n",
    "                \n",
    "            # print(S28.min(),S28.max())\n",
    "        \n",
    "        xs = torch.stack(bag_items, dim=0)            # [n,1,28,28]\n",
    "        return xs, y\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "\n",
    "extractor = RoBERTa_FeatureExtractor(device=device)\n",
    "X_raw_text,y_labels  = [ extractor.extract_bag(patient_text).to(device) for patient_text in X_text ], torch.tensor(y_text ).to(device)\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(X_raw_text, y_labels, test_size=0.2, shuffle=True, stratify= y_text)"
