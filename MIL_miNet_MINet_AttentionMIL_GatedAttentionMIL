    "\n",
    "    train_acc = correct / total\n",
    "    train_loss = loss_sum / total\n",
    "\n",
    "    # --- Fase de evaluación ---\n",
    "    model.eval()\n",
    "    total_test, correct_test, loss_sum_test = 0, 0, 0.0\n",
