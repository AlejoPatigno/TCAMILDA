    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from transformers import RobertaModel, RobertaTokenizer\n",
    "from torch.utils.data import DataLoader, Dataset\n",
    "import numpy as np\n",
    "\n",
    "import math\n",
    "import torch\n",
    "from transformers import RobertaModel, RobertaTokenizer\n",
    "\n",
    "class RoBERTa_FeatureExtractor:\n",
    "    def __init__(\n",
    "        self,\n",
    "        device=\"cuda\" if torch.cuda.is_available() else \"cpu\",\n",
    "        batch_size=32,\n",
    "        max_length=128,\n",
    "        # Campos a priorizar si el item es dict\n",
    "        text_fields=(\"response\",),\n",
    "        fallback_fields=(\"text\", \"utterance\", \"sentence\", \"transcript\"),\n",
    "        # Si quiere formar una frase combinando campos (por ejemplo pregunta+respuesta)\n",
    "        combine_fields=None,   # e.g. (\"question\", \"response\")\n",
    "        combine_sep=\" \",\n",
    "        normalize_minmax=False,\n",
    "    ):\n",
    "        self.device = device\n",
    "        self.batch_size = batch_size\n",
    "        self.max_length = max_length\n",
    "\n",
    "        self.text_fields = tuple(text_fields) if text_fields else ()\n",
    "        self.fallback_fields = tuple(fallback_fields) if fallback_fields else ()\n",
    "        self.combine_fields = tuple(combine_fields) if combine_fields else None\n",
    "        self.combine_sep = combine_sep\n",
    "        self.normalize_minmax = normalize_minmax\n",
    "\n",
    "        self.tokenizer = RobertaTokenizer.from_pretrained(\"roberta-base\")\n",
    "        self.model = RobertaModel.from_pretrained(\"roberta-base\").to(self.device)\n",
    "        self.model.eval()\n",
    "\n",
    "    @staticmethod\n",
    "    def _is_nan(x):\n",
    "        return isinstance(x, float) and math.isnan(x)\n",
    "\n",
    "    @staticmethod\n",
    "    def _clean_text(x):\n",
    "        \"\"\"Convierte x a str válida o devuelve None si es vacío/NaN/None.\"\"\"\n",
    "        if x is None or RoBERTa_FeatureExtractor._is_nan(x):\n",
    "            return None\n",
    "\n",
    "        # Si viene tokenizado como lista/tupla, unir tokens\n",
    "        if isinstance(x, (list, tuple)):\n",
    "            toks = [str(t) for t in x if t is not None and not RoBERTa_FeatureExtractor._is_nan(t)]\n",
    "            s = \" \".join(toks).strip()\n",
    "            return s if s else None\n",
    "\n",
    "        s = str(x).strip()\n",
    "        return s if s else None\n",
    "\n",
    "    def _dict_to_text(self, d):\n",
    "        \"\"\"Extrae texto desde un dict usando reglas de prioridad.\"\"\"\n",
    "        if not isinstance(d, dict):\n",
    "            return None\n",
    "\n",
    "        # 1) Combinar campos si se especifica y están presentes\n",
    "        if self.combine_fields is not None:\n",
    "            parts = []\n",
    "            ok_any = False\n",
    "            for k in self.combine_fields:\n",
    "                if k in d:\n",
    "                    s = self._clean_text(d.get(k))\n",
    "                    if s is not None:\n",
    "                        parts.append(s)\n",
    "                        ok_any = True\n",
    "            if ok_any:\n",
    "                joined = self.combine_sep.join(parts).strip()\n",
    "                return joined if joined else None\n",
    "\n",
    "        # 2) Prioridad: text_fields\n",
    "        for k in self.text_fields:\n",
    "            if k in d:\n",
    "                s = self._clean_text(d.get(k))\n",
    "                if s is not None:\n",
    "                    return s\n",
    "\n",
    "        # 3) Fallback: fallback_fields\n",
    "        for k in self.fallback_fields:\n",
    "            if k in d:\n",
    "                s = self._clean_text(d.get(k))\n",
    "                if s is not None:\n",
    "                    return s\n",
    "\n",
    "        return None\n",
    "\n",
    "    def _items_to_text_list(self, items):\n",
    "        \"\"\"\n",
    "        items puede ser:\n",
    "        - str\n",
    "        - list[str]\n",
    "        - list[dict]\n",
    "        - mezcla (list con str/dict)\n",
    "        \"\"\"\n",
    "        if items is None:\n",
    "            return []\n",
    "\n",
    "        if isinstance(items, str):\n",
    "            s = self._clean_text(items)\n",
    "            return [s] if s is not None else []\n",
    "\n",
    "        if not isinstance(items, (list, tuple)):\n",
    "            s = self._clean_text(items)\n",
    "            return [s] if s is not None else []\n",
    "\n",
    "        texts = []\n",
    "        for it in items:\n",
    "            if isinstance(it, dict):\n",
    "                s = self._dict_to_text(it)\n",
    "            else:\n",
    "                s = self._clean_text(it)\n",
    "            if s is not None:\n",
    "                texts.append(s)\n",
    "        return texts\n",
    "\n",
    "    def extract_bag(self, bag_items):\n",
    "        \"\"\"\n",
    "        Input: list[dict] (o list[str]) de un paciente.\n",
    "        Output: Tensor [N, 768] en CPU.\n",
    "        \"\"\"\n",
    "        texts = self._items_to_text_list(bag_items)\n",
    "\n",
    "        # Bag vacío -> vector dummy para evitar fallos en MIL downstream\n",
    "        if len(texts) == 0:\n",
    "            return torch.zeros(1, 768)\n",
    "\n",
    "        all_embeddings = []\n",
    "\n",
    "        for i in range(0, len(texts), self.batch_size):\n",
    "            batch_texts = texts[i : i + self.batch_size]\n",
    "\n",
    "            encoded = self.tokenizer(\n",
    "                batch_texts,\n",
    "                return_tensors=\"pt\",\n",
    "                padding=True,\n",
    "                truncation=True,\n",
    "                max_length=self.max_length,\n",
    "            ).to(self.device)\n",
    "\n",
    "            with torch.no_grad():\n",
    "                out = self.model(**encoded)\n",
    "\n",
    "            # CLS pooling: [B, 768]\n",
    "            emb = out.last_hidden_state[:, 0, :]\n",
    "\n",
    "            # Normalización opcional (si decide mantenerla)\n",
    "            if self.normalize_minmax:\n",
    "                # min-max por batch (su idea original); robusto a denom=0\n",
