    "            correct_test += (pred.view_as(y) == y).sum().item()\n",
    "\n",
    "    test_acc = correct_test / total_test\n",
    "    test_loss = loss_sum_test / total_test\n",
    "\n",
    "    return train_acc, train_loss, test_acc, test_loss\n",
