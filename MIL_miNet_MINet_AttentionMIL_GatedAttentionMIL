    "    \n",
    "        # Gated attention\n",
    "        A_V = self.attention_V(H)                 # [K,L]\n",
    "        A_U = self.attention_U(H)                 # [K,L]\n",
    "        A   = self.attention_w(A_V * A_U)         # [K,B]  (B=ATTENTION_BRANCHES)\n",
    "    \n",
    "        A = torch.transpose(A, 1, 0)              # [B,K]\n",
    "        A = F.softmax(A, dim=1)                   # softmax sobre instancias\n",
    "    \n",
    "        Z = torch.mm(A, H)                        # [B,M]\n",
    "        Y_prob = self.classifier(Z)               # [B,1]\n",
    "        Y_hat  = (Y_prob >= 0.5).float()\n",
    "    \n",
    "        return Y_prob, Y_hat, A\n",
    "\n",
