    "# ============================================================\n",
    "# FIGURA 2x2: UMAP (filas: bags vs instancias, columnas: MEL vs EMB)\n",
    "#  - Bags: color por clase (0/1)\n",
    "#  - Instancias: marcador por clase (0=^ triángulo, 1=o bolas) y color por bag-id\n",
    "# ============================================================\n",
    "import numpy as np\n",
    "import torch\n",
    "from torch.utils.data import DataLoader\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# UMAP\n",
    "try:\n",
    "    import umap\n",
    "except ImportError:\n",
    "    !pip -q install umap-learn\n",
    "    import umap\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Utilidades generales\n",
    "# ------------------------------------------------------------\n",
    "@torch.no_grad()\n",
    "def bag_to_feature_mean(xs: torch.Tensor, k = 15) -> torch.Tensor:\n",
    "    \"\"\"xs: [n, ...] -> mean over instances -> flatten\"\"\"\n",
    "    xs = xs.float()\n",
    "    n = xs.shape[0]\n",
    "    if n >= k:\n",
    "        idx = torch.randperm(n, device=xs.device)[:k]\n",
    "    else:\n",
    "        idx = torch.randint(0, n, (k,), device=xs.device)\n",
    "\n",
    "    sampled = xs.index_select(0, idx)   # [k, ...]\n",
    "    return sampled.flatten().cpu()\n",
    "\n",
    "@torch.no_grad()\n",
    "def instance_to_feature_anyshape(x: torch.Tensor) -> torch.Tensor:\n",
    "    \"\"\"x puede ser (D,), (H,W), (C,H,W), etc. -> flatten\"\"\"\n",
    "    if not torch.is_tensor(x):\n",
    "        x = torch.as_tensor(x)\n",
    "    if x.dim() == 0:\n",
    "        x = x.unsqueeze(0)\n",
    "    return x.float().flatten().cpu()\n",
    "\n",
    "\n",
    "def _iter_bags_from_batch(xs, y):\n",
    "    \"\"\"\n",
    "    Normaliza el batch a un iterador de (bag_xs, bag_y_float)\n",
    "    bag_xs: tensor [n, ...]\n",
    "    y: tensor [B,1] o [B]\n",
    "    \"\"\"\n",
    "    if isinstance(xs, (list, tuple)):\n",
    "        for i in range(len(xs)):\n",
    "            yield xs[i], float(y[i].detach().cpu().view(-1)[0])\n",
    "    else:\n",
    "        B = xs.shape[0]\n",
    "        for i in range(B):\n",
    "            yield xs[i], float(y[i].detach().cpu().view(-1)[0])\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Extracción BAG-level (para MEL o EMB, ambos soportados)\n",
    "# ------------------------------------------------------------\n",
    "def extract_bag_level_matrix_any(loader: DataLoader, max_bags: int | None = None):\n",
    "    X_list, y_list = [], []\n",
    "    n_seen = 0\n",
    "\n",
    "    for xs, y in loader:\n",
    "        for bag_xs, bag_y in _iter_bags_from_batch(xs, y):\n",
    "            feat = bag_to_feature_mean(bag_xs)  # flatten del promedio\n",
    "            # print(feat.shape)\n",
    "            X_list.append(feat.numpy())\n",
    "            y_list.append(1 if bag_y >= 0.5 else 0)\n",
    "            n_seen += 1\n",
    "            if max_bags is not None and n_seen >= max_bags:\n",
    "                break\n",
    "        if max_bags is not None and n_seen >= max_bags:\n",
    "            break\n",
    "\n",
    "    X = np.stack(X_list, axis=0).astype(np.float32)\n",
    "    y = np.array(y_list, dtype=np.int64)\n",
    "    return X, y\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Extracción INSTANCE-level (para MEL o EMB)\n",
    "#   - cada instancia hereda la etiqueta del bag\n",
    "#   - bag_ids para colorear cada bag distinto\n",
    "# ------------------------------------------------------------\n",
    "def extract_instance_level_matrix_any(\n",
    "    loader: DataLoader,\n",
    "    max_bags: int | None = None,\n",
    "    max_instances_total: int | None = None,\n",
    "):\n",
    "    X_list, y_list, bagid_list = [], [], []\n",
    "    bag_id_global = 0\n",
    "    n_instances = 0\n",
    "\n",
    "    for xs, y in loader:\n",
    "        for bag_xs, bag_y in _iter_bags_from_batch(xs, y):\n",
    "            bag_label = 1 if bag_y >= 0.5 else 0\n",
    "\n",
    "            # bag_xs: [n, ...]\n",
    "            n_i = bag_xs.shape[0]\n",
    "            for j in range(n_i):\n",
    "                feat = instance_to_feature_anyshape(bag_xs[j])\n",
    "                # print(feat.shape)\n",
    "                X_list.append(feat.numpy())\n",
    "                y_list.append(bag_label)\n",
    "                bagid_list.append(bag_id_global)\n",
    "\n",
    "                n_instances += 1\n",
    "                if max_instances_total is not None and n_instances >= max_instances_total:\n",
    "                    break\n",
    "\n",
    "            bag_id_global += 1\n",
    "            if (max_instances_total is not None and n_instances >= max_instances_total) or \\\n",
    "               (max_bags is not None and bag_id_global >= max_bags):\n",
    "                break\n",
    "\n",
    "        if (max_instances_total is not None and n_instances >= max_instances_total) or \\\n",
    "           (max_bags is not None and bag_id_global >= max_bags):\n",
    "            break\n",
    "\n",
    "    X = np.stack(X_list, axis=0).astype(np.float32)\n",
    "    y = np.array(y_list, dtype=np.int64)\n",
    "    bag_ids = np.array(bagid_list, dtype=np.int64)\n",
    "    return X, y, bag_ids\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# UMAP (fit/transform) helper\n",
    "# ------------------------------------------------------------\n",
    "def fit_umap(X: np.ndarray, n_neighbors=20, min_dist=0.05, metric=\"euclidean\", random_state=42):\n",
    "    reducer = umap.UMAP(\n",
    "        n_neighbors=n_neighbors,\n",
    "        min_dist=min_dist,\n",
    "        metric=metric,\n",
    "        random_state=random_state,\n",
    "        n_components=2,\n",
    "    )\n",
    "    Z = reducer.fit_transform(X)\n",
    "    return Z\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Plot helpers sobre un Axes (NO crea figures nuevas)\n",
    "# ------------------------------------------------------------\n",
    "def plot_umap_baglevel(ax, Z, y, title):\n",
    "    # Bag-level: color por clase\n",
    "    mask0 = (y == 0)\n",
    "    mask1 = (y == 1)\n",
    "    ax.scatter(Z[mask0, 0], Z[mask0, 1], s=16, alpha=0.8, label=\"Clase 0\")\n",
    "    ax.scatter(Z[mask1, 0], Z[mask1, 1], s=16, alpha=0.8, label=\"Clase 1\")\n",
    "    ax.set_title(title)\n",
    "    ax.set_xlabel(\"UMAP-1\")\n",
    "    ax.set_ylabel(\"UMAP-2\")\n",
    "    ax.set_xlim(-15,20)\n",
    "    ax.set_ylim(-10,20)\n",
    "    ax.legend(loc=\"best\", fontsize=8)\n",
    "\n",
    "\n",
    "def plot_umap_instancelevel(ax, Z, y, bag_ids, title):\n",
    "    # Instance-level: marcador por clase, color por bag-id\n",
    "    unique_bags = np.unique(bag_ids)\n",
    "    n_bags = len(unique_bags)\n",
    "    cmap = plt.get_cmap(\"tab20\" if n_bags <= 20 else \"hsv\")\n",
    "    bag_to_idx = {b: i for i, b in enumerate(unique_bags)}\n",
    "\n",
    "    for cls, marker, name in [(0, \"^\", \"Clase 0 (triángulos)\"), (1, \"o\", \"Clase 1 (bolas)\")]:\n",
    "        m = (y == cls)\n",
    "        if not np.any(m):\n",
    "            continue\n",
    "        color_vals = np.array([bag_to_idx[b] for b in bag_ids[m]], dtype=np.float32)\n",
    "        color_vals_norm = color_vals / max(n_bags - 1, 1)\n",
    "\n",
    "        ax.scatter(\n",
    "            Z[m, 0], Z[m, 1],\n",
    "            c=color_vals_norm,\n",
    "            cmap=cmap,\n",
    "            s=14,\n",
    "            alpha=0.8,\n",
    "            marker=marker,\n",
    "            linewidths=0.0,\n",
    "            label=name,\n",
    "        )\n",
    "\n",
    "    ax.set_title(title)\n",
    "    ax.set_xlabel(\"UMAP-1\")\n",
    "    ax.set_ylabel(\"UMAP-2\")\n",
    "    ax.set_xlim(-15,20)\n",
    "    ax.set_ylim(-10,20)\n",
    "    ax.legend(loc=\"best\", fontsize=8)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# FUNCIÓN PRINCIPAL: construye la figura 2x2\n",
    "# ============================================================\n",
    "def plot_umap_grid_2x2(\n",
    "    loader_mel: DataLoader,\n",
    "    loader_emb: DataLoader,\n",
    "    max_bags: int | None = None,\n",
    "    max_instances_total: int | None = None,\n",
    "    umap_kwargs=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Columnas:\n",
    "      col 0: MEL spectrograms (AudioBagsMEL28)\n",
    "      col 1: Embedded (AudioBagsEmbedded)\n",
    "    Filas:\n",
    "      fila 0: bag-level\n",
    "      fila 1: instance-level\n",
    "    \"\"\"\n",
    "    if umap_kwargs is None:\n",
    "        umap_kwargs = dict(n_neighbors=20, min_dist=0.05, metric=\"euclidean\", random_state=42)\n",
    "\n",
    "    # ---- MEL: bag-level + instance-level\n",
    "    X_mel_b, y_mel_b = extract_bag_level_matrix_any(loader_mel, max_bags=max_bags)\n",
    "    Z_mel_b = fit_umap(X_mel_b, **umap_kwargs)\n",
    "\n",
    "    X_mel_i, y_mel_i, bid_mel_i = extract_instance_level_matrix_any(\n",
    "        loader_mel, max_bags=max_bags, max_instances_total=max_instances_total\n",
    "    )\n",
    "    Z_mel_i = fit_umap(X_mel_i, **umap_kwargs)\n",
    "\n",
    "    # ---- EMB: bag-level + instance-level\n",
    "    X_emb_b, y_emb_b = extract_bag_level_matrix_any(loader_emb, max_bags=max_bags)\n",
    "    Z_emb_b = fit_umap(X_emb_b, **umap_kwargs)\n",
    "    # umap_kwargs['n_neighbors'] = umap_kwargs['n_neighbors'] // 10\n",
    "\n",
    "    X_emb_i, y_emb_i, bid_emb_i = extract_instance_level_matrix_any(\n",
    "        loader_emb, max_bags=max_bags, max_instances_total=max_instances_total\n",
    "    )\n",
    "    Z_emb_i = fit_umap(X_emb_i, **umap_kwargs)\n",
    "\n",
    "    # ---- Plot 2x2\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(14, 8))\n",
    "\n",
    "    plot_umap_baglevel(axes[0, 0], Z_mel_b, y_mel_b, \"MEL — Bag-level\")\n",
    "    plot_umap_baglevel(axes[0, 1], Z_emb_b, y_emb_b, \"Embedded — Bag-level\")\n",
    "\n",
    "    plot_umap_instancelevel(axes[1, 0], Z_mel_i, y_mel_i, bid_mel_i, \"MEL — Instance-level (color=bag)\")\n",
    "    plot_umap_instancelevel(axes[1, 1], Z_emb_i, y_emb_i, bid_emb_i, \"Embedded — Instance-level (color=bag)\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    return fig, axes\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# USO (ejemplo)\n",
    "# ============================================================\n",
    "\n",
    "neighbors = 784 // 2\n",
    "dataset_mel = AudioBagsMEL28(X_target, y_target, bag_size=30, device=device)\n",
    "loader_mel  = DataLoader(dataset_mel, batch_size=8, shuffle=False, num_workers=0)\n",
    "\n",
    "dataset_emb = AudioBagsEmbedded(X_raw_text,y_labels, bag_size=30, device=device)\n",
    "loader_emb  = DataLoader(dataset_emb, batch_size=8, shuffle=False, num_workers=0)\n",
    "\n",
    "plot_umap_grid_2x2(\n",
    "    loader_mel, loader_emb,\n",
    "    max_bags=200,                 # opcional (recomendado si hay muchos)\n",
    "    max_instances_total=20000,    # opcional (recomendado para UMAP)\n",
    "    umap_kwargs=dict(n_neighbors=25, min_dist=0.05, metric=\"euclidean\", random_state=42)\n",
    ")\n"
