    "\n",
    "def test_eval(model, test_set):\n",
    "    num_test_batch = len(test_set)\n",
    "    test_loss = np.zeros((num_test_batch, 1), dtype=float)\n",
    "    test_acc  = np.zeros((num_test_batch, 1), dtype=float)\n",
    "    for ibatch, (Xb, yb) in enumerate(test_set):\n",
    "        result = model.test_on_batch(Xb, yb)  # <-- cambio\n",
    "        test_loss[ibatch] = result[0]\n",
    "        test_acc[ibatch][0] = result[1]\n",
    "    return np.mean(test_loss), np.mean(test_acc)\n",
    "\n",
    "def train_eval(model, train_set):\n",
    "    num_train_batch = len(train_set)\n",
    "    train_loss = np.zeros((num_train_batch, 1), dtype=float)\n",
    "    train_acc  = np.zeros((num_train_batch, 1), dtype=float)\n",
    "    shuffle(train_set)\n",
    "    for ibatch, (Xb, yb) in enumerate(train_set):\n",
    "        result = model.train_on_batch(Xb, yb)  # <-- cambio\n",
    "        train_loss[ibatch] = result[0]\n",
    "        train_acc[ibatch][0] = result[1]\n",
    "    return np.mean(train_loss), np.mean(train_acc)\n",
    "\n",
    "\n",
    "import numpy as np\n",
    "import torch\n",
    "\n",
    "def _mil_dataset_to_bags(mil_ds):\n",
    "    bags = []\n",
    "    for i in range(len(mil_ds)):\n",
    "        xs, y = mil_ds[i]\n",
    "        xs = xs.detach().cpu().numpy()\n",
    "        xs = xs.reshape(xs.shape[0], -1).astype(np.float32)\n",
    "\n",
    "        # Sanitización fuerte\n",
    "        xs = np.nan_to_num(xs, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "\n",
    "        yv = float(y.detach().cpu().item())\n",
    "        bags.append((xs, yv))\n",
    "    return bags\n",
    "\n",
    "def load_dataset_simple(X_audio_train, y_audio_train, X_audio_test, y_audio_test, bag_size=10):\n",
    "    torch_device = \"cpu\"  # Keras/TensorFlow runs on CPU here\n",
    "\n",
    "    train_ds = AudioBagsMEL28(X_audio_train, y_audio_train, bag_size=bag_size, device=torch_device)\n",
    "    test_ds  = AudioBagsMEL28(X_audio_test,  y_audio_test,  bag_size=bag_size, device=torch_device)\n",
    "\n",
    "    dataset = {\n",
    "        \"train\": _mil_dataset_to_bags(train_ds),\n",
    "        \"test\":  _mil_dataset_to_bags(test_ds),\n",
    "    }\n",
    "    return dataset\n",
    "\n",
    "from sklearn.metrics import accuracy_score, precision_recall_fscore_support, recall_score\n",
    "import tensorflow as tf\n",
    "\n",
    "bce = tf.keras.losses.BinaryCrossentropy(from_logits=False)\n",
    "\n",
    "def evaluate_bag_metrics_keras(model, bags, thr=0.5):\n",
    "    y_true, y_prob = [], []\n",
    "    for X_bag, y_bag in bags:\n",
    "        # model output expected shape (1,1) or (1,)\n",
    "        p = model.predict(X_bag, verbose=0)\n",
    "        p = float(np.asarray(p).reshape(-1)[0])\n",
    "        y_true.append(int(y_bag))\n",
    "        y_prob.append(p)\n",
    "\n",
    "    y_true = np.asarray(y_true, dtype=int)\n",
    "    y_prob = np.asarray(y_prob, dtype=float)\n",
    "    y_pred = (y_prob >= thr).astype(int)\n",
    "\n",
    "    acc = float(accuracy_score(y_true, y_pred))\n",
    "    prec, rec, f1, _ = precision_recall_fscore_support(\n",
    "        y_true, y_pred, average=\"macro\", zero_division=0\n",
    "    )\n",
    "    uar = float(recall_score(y_true, y_pred, average=\"macro\", zero_division=0))\n",
    "\n",
    "    # mean BCE loss over bags\n",
    "    loss_mean = float(bce(y_true.astype(np.float32), y_prob.astype(np.float32)).numpy())\n",
    "\n",
    "    return {\n",
    "        \"accuracy\": acc,\n",
    "        \"loss_mean\": loss_mean,\n",
    "        \"precision_macro\": float(prec),\n",
    "        \"recall_macro\": float(rec),\n",
    "        \"f1_macro\": float(f1),\n",
    "        \"uar\": uar,\n",
    "    }\n",
    "\n",
    "import time\n",
    "from tensorflow.keras.layers import Input, Dense, Dropout\n",
    "from tensorflow.keras.models import Model\n",
    "from tensorflow.keras.optimizers import SGD\n",
    "from tensorflow.keras.regularizers import l2\n",
    "\n",
    "import tensorflow as tf\n",
    "\n",
    "def bag_loss_stable(y_true, y_pred):\n",
    "    y_pred = tf.clip_by_value(y_pred, 1e-7, 1.0 - 1e-7)\n",
    "    return tf.reduce_mean(\n",
    "        -(y_true * tf.math.log(y_pred) + (1.0 - y_true) * tf.math.log(1.0 - y_pred))\n",
    "    )\n",
    "\n",
    "def MI_Net_simple(dataset):\n",
    "    train_bags = dataset[\"train\"]\n",
