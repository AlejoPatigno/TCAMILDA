    "                                respuesta_participante.append(value)\n",
    "                        \n",
    "\n",
    "                    # Añadir el último par pregunta-respuesta si existe\n",
    "                    if pregunta_ellie is not None and respuesta_participante:\n",
    "                        conversacion_actual.append((pregunta_ellie, \" \".join(respuesta_participante)))\n",
