    "import os \n",
    "import zipfile\n",
    "import tensorflow as tf\n",
    "\n",
    "def cargar_etiquetas_audio_text(base_path: str, seg_len=1, sr=16000):\n",
    "    \"\"\"\n",
    "    Returns:\n",
    "      - rutas_audio_train: list of numpy arrays (full audio per participant in train)\n",
    "      - etiquetas_train:  np.array of labels aligned with rutas_audio_train\n",
    "      - rutas_audio_test:  list of numpy arrays (full audio per participant in dev/test)\n",
    "      - etiquetas_test:   np.array of labels aligned with rutas_audio_test\n",
    "      - tamaños:          list with number of segments (bagsize) per participant (train+test order)\n",
    "      - conversaciones_train: list where each element is a list of dicts for that participant:\n",
    "           [{\"start\": float, \"end\": float, \"text\": str,\n",
    "             \"question\": str, \"response\": str,\n",
    "             \"start_ellie\": float, \"end_ellie\": float,\n",
    "             \"start_patient\": float, \"end_patient\": float}, ...]\n",
    "      - conversaciones_test: same as above but aligned with rutas_audio_test\n",
    "    \"\"\"\n",
    "    train_df = pd.read_csv(os.path.join(base_path, 'train_split_Depression_AVEC2017.csv'),\n",
    "                           index_col='Participant_ID')\n",
    "    dev_df = pd.read_csv(os.path.join(base_path, 'dev_split_Depression_AVEC2017.csv'),\n",
    "                         index_col='Participant_ID')\n",
    "\n",
    "    rutas_audio_train = []\n",
    "    etiquetas_train = []\n",
    "    conversaciones_train = []\n",
    "\n",
    "    rutas_audio_test = []\n",
    "    etiquetas_test = []\n",
    "    conversaciones_test = []\n",
    "\n",
    "    tamaños = []\n",
    "\n",
    "    for participante_id in sorted(os.listdir(base_path)):\n",
    "        ruta_P = os.path.join(base_path, participante_id)\n",
    "        if not os.path.isdir(ruta_P):\n",
    "            continue\n",
    "\n",
    "        # require the folder to start with three-digit ID\n",
    "        if len(participante_id) < 3 or not participante_id[:3].isdigit():\n",
    "            continue\n",
    "        pid = int(participante_id[:3])\n",
    "\n",
    "        # decide split and label\n",
    "        if pid in train_df.index:\n",
    "            split = 'train'\n",
    "            label = int(train_df.loc[pid, 'PHQ8_Binary'])\n",
    "        elif pid in dev_df.index:\n",
    "            split = 'dev'\n",
    "            label = int(dev_df.loc[pid, 'PHQ8_Binary'])\n",
    "        else:\n",
    "            # not labeled -> skip\n",
    "            continue\n",
    "\n",
    "        transcript_path = os.path.join(ruta_P, f\"{participante_id[:3]}_TRANSCRIPT.csv\")\n",
    "        audio_path = os.path.join(ruta_P, f\"{participante_id[:3]}_AUDIO.wav\")\n",
    "\n",
    "        if not (os.path.exists(transcript_path) and os.path.exists(audio_path)):\n",
    "            # skip if missing files\n",
    "            continue\n",
    "\n",
    "        # load transcript\n",
    "        df = pd.read_csv(transcript_path, sep='\\t')\n",
    "\n",
    "        # load audio\n",
    "        y, _sr = librosa.load(audio_path, sr=sr, mono=True)\n",
    "\n",
    "        # variables for grouping question-response pairs\n",
    "        pregunta_ellie = None\n",
    "        start_ellie = None\n",
    "        end_ellie = None\n",
    "        start_segment_sample = None\n",
    "\n",
    "        start_patient = None\n",
    "        end_patient = None\n",
    "        respuesta_participante = \"\"\n",
    "\n",
    "        segments_for_participant = []\n",
    "        segmentos_audio = []\n",
    "\n",
    "        # iterate rows in order\n",
    "        for i in range(df.shape[0]):\n",
    "            speaker = df.loc[i, 'speaker']\n",
    "            value = str(df.loc[i, 'value']).strip()\n",
    "            # ensure numeric times\n",
    "            st = float(df.loc[i, 'start_time'])\n",
    "            et = float(df.loc[i, 'stop_time'])\n",
    "\n",
    "            if speaker == 'Ellie':\n",
    "                # if there is a pending question+answer, save it before starting a new question\n",
    "                if pregunta_ellie is not None and respuesta_participante:\n",
    "                    # compute stop sample: extend by seg_len seconds but clamp to audio\n",
    "                    stop_sample = int(min(len(y)/sr, end_patient + seg_len) * sr)\n",
    "                    start_sample = int(start_segment_sample)\n",
    "                    segmentos_audio.append(y[start_sample:stop_sample])\n",
    "                    # store numpy slice (optionally)\n",
    "                    # audio_segment = y[start_sample:stop_sample]\n",
    "\n",
    "                    segments_for_participant.append({\n",
    "                        \"start\": start_sample / sr,\n",
    "                        \"end\": stop_sample / sr,\n",
    "                        \"text\": f\"Ellie: {pregunta_ellie} - Participant: {respuesta_participante.strip()}\",\n",
    "                        \"question\": pregunta_ellie,\n",
    "                        \"response\": respuesta_participante.strip(),\n",
    "                        \"start_ellie\": start_ellie,\n",
    "                        \"end_ellie\": end_ellie,\n",
    "                        \"start_patient\": start_patient,\n",
    "                        \"end_patient\": end_patient\n",
    "                    })\n",
    "                    respuesta_participante = \"\"\n",
    "\n",
    "                # start new Ellie question\n",
    "                pregunta_ellie = value\n",
    "                start_ellie = st\n",
    "                end_ellie = et\n",
    "                # compute start of segment in samples (extend backwards seg_len sec)\n",
    "                start_segment_sample = int(max(0, start_ellie - seg_len) * sr)\n",
    "\n",
    "                # reset patient markers\n",
    "                start_patient = None\n",
    "                end_patient = None\n",
    "\n",
    "            elif speaker == 'Participant':\n",
    "                # accumulate participant reply for current Ellie question\n",
    "                if pregunta_ellie is not None:\n",
    "                    if start_patient is None:\n",
    "                        start_patient = st\n",
    "                    end_patient = et\n",
    "                    # concatenate text\n",
    "                    respuesta_participante += \" \" + value\n",
    "            \n",
    "\n",
    "        # after loop, save last pair if present\n",
    "        if pregunta_ellie is not None and respuesta_participante:\n",
    "            stop_sample = int(min(len(y)/sr, end_patient + seg_len) * sr)\n",
    "            start_sample = int(start_segment_sample)\n",
    "            segments_for_participant.append({\n",
    "                \"start\": start_sample / sr,\n",
    "                \"end\": stop_sample / sr,\n",
    "                \"text\": f\"Ellie: {pregunta_ellie} - Participant: {respuesta_participante.strip()}\",\n",
    "                \"question\": pregunta_ellie,\n",
    "                \"response\": respuesta_participante.strip(),\n",
    "                \"start_ellie\": start_ellie,\n",
    "                \"end_ellie\": end_ellie,\n",
    "                \"start_patient\": start_patient,\n",
    "                \"end_patient\": end_patient\n",
    "            })\n",
    "\n",
    "        # append outputs per split\n",
    "        tamaños.append(participante_id)\n",
    "        if split == 'train':\n",
    "            rutas_audio_train.append(segmentos_audio)\n",
    "            etiquetas_train.append(label)\n",
    "            conversaciones_train.append(segments_for_participant)\n",
    "        else:\n",
    "            rutas_audio_test.append(segmentos_audio)\n",
    "            etiquetas_test.append(label)\n",
    "            conversaciones_test.append(segments_for_participant)\n",
    "\n",
    "    return (\n",
    "        rutas_audio_train,\n",
    "        np.array(etiquetas_train, dtype=int),\n",
    "        rutas_audio_test,\n",
    "        np.array(etiquetas_test, dtype=int),\n",
    "        tamaños,\n",
    "        conversaciones_train,\n",
    "        conversaciones_test,\n",
    "    )\n",
    "\n",
    "path = '/kaggle/input/daic-woz/DAIC-WOZ'\n",
    "X_audio_train, y_audio_train, X_audio_test, y_audio_test, tamaños_target,_, _= cargar_etiquetas_audio_text(path, sr = 16000)\n",
    "# np.save('y_target', y_target)\n",
    "print(len(X_audio_train), y_audio_train.shape, len(tamaños_target))\n",
    "# print(len(X_audio))\n",
    "print(np.unique(y_audio_train))\n",
    "# X_target, y_target = X_audio, y"
