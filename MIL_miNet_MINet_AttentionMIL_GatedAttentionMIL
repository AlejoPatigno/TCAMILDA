    "\n",
    "    # --- Etiqueta cada punto con el número de sujeto\n",
    "    # Offset para evitar que el texto tape el punto\n",
    "    dx = 0.004 * (xmax - xmin + 1e-9)\n",
    "    dy = 0.004 * (ymax - ymin + 1e-9)\n",
    "\n",
