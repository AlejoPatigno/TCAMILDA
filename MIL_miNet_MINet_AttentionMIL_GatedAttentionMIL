    "\n",
    "        self.attention_w = nn.Linear(self.L, self.ATTENTION_BRANCHES) # matrix w (or vector w if self.ATTENTION_BRANCHES==1)\n",
    "\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Linear(self.M*self.ATTENTION_BRANCHES, 1),\n",
    "            nn.Sigmoid()\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        \"\"\"\n",
    "        x puede ser:\n",
    "          - [K, 1, 28, 28]        (una bolsa)\n",
    "          - [1, K, 1, 28, 28]     (batch_size=1)\n",
    "        \"\"\"\n",
    "        if x.dim() == 5:\n",
    "            x = x.squeeze(0)      # -> [K,1,28,28]\n",
    "        elif x.dim() != 4:\n",
    "            raise ValueError(f\"Forma de entrada no soportada: {x.shape}\")\n",
    "    \n",
    "        # CNN extractor\n",
    "        H = self.feature_extractor_part1(x)       # [K,50,4,4]\n",
    "        H = H.view(-1, 50 * 4 * 4)                # [K,800]\n",
    "        H = self.feature_extractor_part2(H)       # [K,M]\n",
    "    \n",
    "        # Gated attention\n",
    "        A_V = self.attention_V(H)                 # [K,L]\n",
    "        A_U = self.attention_U(H)                 # [K,L]\n",
    "        A   = self.attention_w(A_V * A_U)         # [K,B]  (B=ATTENTION_BRANCHES)\n",
