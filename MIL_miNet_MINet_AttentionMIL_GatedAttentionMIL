    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import os \n",
    "import zipfile\n",
    "import tensorflow as tf\n",
    "\n",
    "def cargar_etiquetas_audio(base_path: str, seg_len = 1, sr = 8000):\n",
    "    \"\"\"\n",
    "    Lee los archivos de metadatos y asigna etiquetas a los archivos de audio.\n",
    "\n",
    "    Parámetros:\n",
    "    ----------\n",
    "    base_path : str\n",
    "        Ruta base donde se encuentran los directorios 'metadata' y 'audios'.\n",
    "\n",
    "    Retorna:\n",
    "    -------\n",
    "    rutas_audio : list of str\n",
    "        Lista con las rutas completas de los archivos .wav.\n",
    "    etiquetas : list of int\n",
    "        Lista de etiquetas (0 para HC, 1 para PD) correspondiente a cada archivo de audio.\n",
    "    \"\"\"\n",
    "    train = pd.read_csv(base_path + '/train_split_Depression_AVEC2017.csv', index_col='Participant_ID')\n",
    "    dev = pd.read_csv(base_path + '/dev_split_Depression_AVEC2017.csv', index_col='Participant_ID')\n",
    "    labeled = pd.concat([train, dev], axis = 0)\n",
    "    segment_length = sr*seg_len\n",
    "    print(labeled.index.tolist())\n",
    "    # print(labeled.head())\n",
    "    rutas_audio = []\n",
    "    audios = []\n",
    "    etiquetas = []\n",
    "    tamaños = []\n",
    "\n",
    "    # Recorrer archivos .wav\n",
    "\n",
    "    tamaño_hc = 0\n",
    "    tamaño_mdd = 0\n",
    "    for participante_id in os.listdir(base_path):\n",
    "        ruta_P = os.path.join(base_path, participante_id)\n",
    "        if os.path.isdir(ruta_P):\n",
    "            for archives in os.listdir(ruta_P):\n",
    "                \n",
    "                if archives.endswith('TRANSCRIPT.csv') and archives[0] != '.' and int(archives[:3]) in labeled.index.tolist():\n",
    "                    # print(labeled['PHQ8_Binary'])\n",
    "                    ruta_completa = os.path.join(ruta_P, archives)\n",
    "                    df = pd.read_csv(ruta_completa, sep = '\\t')\n",
    "                    numero = participante_id[:3]\n",
    "                    dir_audios = os.path.join(ruta_P, f'{numero}_AUDIO.wav')\n",
    "                    print(dir_audios)\n",
    "                    # try:\n",
    "                      \n",
    "                    y, sr = librosa.load(dir_audios, sr=sr)\n",
    "                    # mfccs, tamaños_audios =preprocesar_audio(y, sr)\n",
    "                \n",
    "                    conversacion_participante = []\n",
    "                    # pregunta_ellie = None\n",
    "                    respuesta_participante = []\n",
    "\n",
    "                    # Procesar la transcripción para agrupar preguntas y respuestas\n",
    "                    for i in range(df.shape[0]):\n",
    "                        speaker = df.loc[i, 'speaker']\n",
    "                        value = str(df.loc[i, 'value']).strip()\n",
    "                        # print(speaker)\n",
    "                        start_time = int(max(0, df.loc[i, 'start_time'] - seg_len) * sr)\n",
    "                        stop_time = int(min(y.shape[0]/sr, df.loc[i, 'stop_time'] + seg_len) * sr)\n",
    "                        if speaker == 'Participant':\n",
    "                            respuesta_participante.append(value)\n",
    "                            conversacion_participante.append(y[start_time : stop_time])\n",
    "                    \n",
    "                    rutas_audio.append(respuesta_participante)\n",
    "                    tamaños.append(participante_id)     \n",
    "                    audios.append(conversacion_participante)\n",
    "                    \n",
    "                    # Extraer ID con regex\n",
    "                    if int(labeled['PHQ8_Binary'][int(participante_id[:3])]) == 1:\n",
    "                        etiquetas += [1 ]\n",
    "                        tamaño_mdd += 1\n",
    "                    else: \n",
    "                        etiquetas += [0 ]\n",
    "                        tamaño_hc += 1\n",
    "                    # except:\n",
    "                    #     pass\n",
    "            \n",
    "            \n",
    "    print(tamaño_hc,tamaño_mdd)\n",
    "    return audios, np.array(etiquetas), tamaños\n",
    "\n",
    "path = '/kaggle/input/daic-woz/DAIC-WOZ'\n",
    "X_audio, y, tamaños_target= cargar_etiquetas_audio(path, sr = 4000)\n",
    "# np.save('y_target', y_target)\n",
    "print(len(X_audio), y.shape, len(tamaños_target))\n",
    "# print(len(X_audio))\n",
    "print(np.unique(y))\n",
    "X_target, y_target = X_audio, y"
