    "                else:\n",
    "                    raise TypeError(f\"Dict sin llaves de audio conocidas: {list(a.keys())}\")\n",
    "\n",
    "        # --- NUEVO: si llega un escalar, es señal de que se iteró un waveform ---\n",
    "        if np.isscalar(a) or isinstance(a, (np.floating, np.integer, float, int)):\n",
    "            raise TypeError(\n",
    "                \"Se recibió un escalar (p.ej. numpy.float32). \"\n",
