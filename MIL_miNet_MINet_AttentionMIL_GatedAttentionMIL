    "            nn.ReLU(),\n",
    "        )\n",
    "\n",
    "        self.attention_V = nn.Sequential(\n",
    "            nn.Linear(self.M, self.L), # matrix V\n",
    "            nn.Tanh()\n",
    "        )\n",
    "\n",
    "        self.attention_U = nn.Sequential(\n",
    "            nn.Linear(self.M, self.L), # matrix U\n",
    "            nn.Sigmoid()\n",
