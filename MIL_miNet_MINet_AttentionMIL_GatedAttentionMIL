    "import torch, torch.nn as nn, torch.nn.functional as F\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision import datasets, transforms\n",
    "import random\n",
    "\n",
    "# --- 1) Dataset MIL sobre MNIST ---\n",
    "# Requisitos:\n",
    "# pip install torchaudio\n",
    "\n",
    "import torch\n",
    "import torchaudio\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import Dataset\n",
    "\n",
    "class AudioBagsMEL28(Dataset):\n",
    "    \"\"\"\n",
    "    Dataset MIL para bolsas de audio -> Mel-espectrograma (dB) -> resize a 28x28.\n",
    "    Mantiene la interfaz del MNISTBags: retorna (xs, y) con:\n",
    "      xs: [bag_size, 1, 28, 28]\n",
    "      y : [1] float32 (0/1 o continuo en [0,1])\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        X_target,\n",
    "        y_target,\n",
    "        bag_size=None,              # si None: usa tamaño natural de la bolsa\n",
    "        sample_rate=16000,\n",
    "        n_mels=64,                  # mel interno (luego se reescala a 28)\n",
    "        n_fft=1024,\n",
    "        hop_length=256,\n",
    "        f_min=0.0,\n",
    "        f_max=None,\n",
    "        normalize_per_instance=True,\n",
    "        device=\"cpu\",\n",
    "    ):\n",
    "        super().__init__()\n",
    "        assert len(X_target) == len(y_target), \"X_target y y_target deben tener misma longitud.\"\n",
    "        self.X = X_target\n",
    "        self.y = y_target\n",
    "        self.bag_size = bag_size\n",
    "        self.sample_rate = sample_rate\n",
    "        self.device = device\n",
    "\n",
    "        self.mel = torchaudio.transforms.MelSpectrogram(\n",
    "            sample_rate=sample_rate,\n",
    "            n_fft=n_fft,\n",
    "            hop_length=hop_length,\n",
    "            n_mels=n_mels,\n",
    "            f_min=f_min,\n",
    "            f_max=f_max,\n",
    "            power=2.0,\n",
    "        ).to(device)\n",
    "\n",
    "        self.to_db = torchaudio.transforms.AmplitudeToDB(stype=\"power\").to(device)\n",
    "        self.normalize_per_instance = normalize_per_instance\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.X)\n",
    "\n",
    "    def _load_audio(self, a):\n",
    "        \"\"\"\n",
    "        a puede ser:\n",
    "        - str/bytes: ruta a archivo\n",
    "        - np.ndarray: waveform (T,), (1,T), (C,T) o (T,C)\n",
    "        - torch.Tensor: waveform (T,), (1,T), (C,T) o (T,C)\n",
    "        Devuelve: wav mono [1,T] en self.device y self.sample_rate\n",
    "        \"\"\"\n",
    "        # 1) Ruta a archivo\n",
    "        if isinstance(a, (str, bytes)):\n",
    "            wav, sr = torchaudio.load(a)\n",
    "            if sr != self.sample_rate:\n",
    "                wav = torchaudio.functional.resample(wav, sr, self.sample_rate)\n",
    "    \n",
    "        # 2) numpy -> torch\n",
    "        elif isinstance(a, np.ndarray):\n",
    "            wav = torch.from_numpy(a)\n",
    "    \n",
    "        # 3) torch tensor\n",
    "        elif torch.is_tensor(a):\n",
    "            wav = a\n",
    "    \n",
    "        else:\n",
    "            raise TypeError(f\"Tipo de audio no soportado: {type(a)}\")\n",
    "    \n",
    "        # Asegurar float32\n",
    "        if torch.is_tensor(wav) and wav.dtype != torch.float32:\n",
    "            wav = wav.float()\n",
    "\n",
    "        # Normalizar forma a [C,T]\n",
    "        if wav.dim() == 1:\n",
    "            wav = wav.unsqueeze(0)  # [1,T]\n",
    "        elif wav.dim() == 2:\n",
    "            # Puede venir [T,C] o [C,T]. Heurística: si la primera dim es muy grande, suele ser T.\n",
    "            if wav.size(0) > wav.size(1) and wav.size(1) in (1, 2):\n",
    "                wav = wav.transpose(0, 1)  # [C,T]\n",
    "        else:\n",
    "            raise TypeError(f\"Waveform con dimensiones no soportadas: {wav.shape}\")\n",
    "    \n",
    "        # Mono\n",
    "        if wav.size(0) > 1:\n",
    "            wav = wav.mean(dim=0, keepdim=True)\n",
    "    \n",
    "        return wav.to(self.device)\n",
    "\n",
    "    def _audio_to_mel28(self, wav_1T: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        wav_1T: [1,T]\n",
    "        return: [1,28,28]\n",
    "        \"\"\"\n",
    "        S = self.mel(wav_1T)              # [1, n_mels, time]\n",
    "        S = self.to_db(S)                 # dB\n",
    "        S = S.unsqueeze(0)                # [1,1,n_mels,time] para interpolate\n",
    "\n",
    "        # Resize a 28x28 (mantiene el modelo intacto)\n",
    "        S28 = F.interpolate(S, size=(28, 28), mode=\"bilinear\", align_corners=False)\n",
    "        S28 = S28.squeeze(0)              # [1,28,28]\n",
    "\n",
    "        if self.normalize_per_instance:\n",
    "            mu = S28.mean()\n",
    "            sigma = S28.std().clamp_min(1e-6)\n",
    "            S28 = (S28 - mu) / sigma\n",
    "\n",
    "        return S28\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        bag = self.X[idx]                 # iterable de audios (waveforms o paths)\n",
    "        y = torch.tensor([float(self.y[idx])], dtype=torch.float32, device=self.device)\n",
    "\n",
    "        # Ajuste de tamaño de bolsa (opcional)\n",
    "        if self.bag_size is not None:\n",
    "            if len(bag) >= self.bag_size:\n",
    "                # muestreo aleatorio sin reemplazo\n",
    "                sel = torch.randperm(len(bag))[: self.bag_size].tolist()\n",
    "                bag_items = [bag[i] for i in sel]\n",
    "            else:\n",
    "                # relleno con reemplazo\n",
    "                sel = torch.randint(0, len(bag), (self.bag_size,)).tolist()\n",
    "                bag_items = [bag[i] for i in sel]\n",
    "        else:\n",
    "            bag_items = list(bag)\n",
    "\n",
    "        xs = []\n",
    "        for a in bag_items:\n",
    "            wav = self._load_audio(a)          # [1,T]\n",
    "            mel28 = self._audio_to_mel28(wav)  # [1,28,28]\n",
    "            xs.append(mel28)\n",
    "\n",
    "        xs = torch.stack(xs, dim=0)            # [n,1,28,28]\n",
    "        return xs, y\n",
    "\n",
    "\n",
    "# --- 2) Codificador por instancia (CNN) ---\n",
    "class InstanceEncoder(nn.Module):\n",
    "    def __init__(self, d=128):\n",
    "        super().__init__()\n",
    "        self.conv = nn.Sequential(\n",
    "            nn.Conv2d(1, 16, 3, 1), nn.ReLU(), nn.MaxPool2d(2),\n",
    "            nn.Conv2d(16, 32, 3, 1), nn.ReLU(), nn.MaxPool2d(2)\n",
    "        )\n",
    "        self.fc = nn.Linear(32 * 5 * 5, d)\n",
    "\n",
    "    def forward(self, x):  # x: [n,1,28,28]\n",
    "        z = self.conv(x)                       # [n,32,5,5]\n",
    "        z = z.view(z.size(0), -1)              # [n,800]\n",
    "        u = F.relu(self.fc(z))                 # [n,d]\n",
    "        return u\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "def confusion_from_binary(y_true, y_pred):\n",
    "    \"\"\"\n",
    "    y_true, y_pred: arrays 0/1 de la misma forma.\n",
    "    Devuelve TP, FP, FN, TN como escalares.\n",
    "    \"\"\"\n",
    "    try:\n",
    "        y_true = y_true.cpu().numpy()\n",
    "        y_pred = y_pred.cpu().numpy()\n",
    "    except:\n",
    "      y_true = y_true.astype(np.int32)\n",
    "      y_pred = y_pred.astype(np.int32)\n",
    "\n",
    "    tp = np.sum((y_true == 1) & (y_pred == 1))\n",
    "    fp = np.sum((y_true == 0) & (y_pred == 1))\n",
    "    fn = np.sum((y_true == 1) & (y_pred == 0))\n",
    "    tn = np.sum((y_true == 0) & (y_pred == 0))\n",
    "\n",
    "    return tp, fp, fn, tn\n",
    "\n",
    "def iou_score(tp, fp, fn, eps=1e-7):\n",
    "    \"\"\"\n",
    "    IoU (Jaccard) para la clase positiva.\n",
    "    IoU = TP / (TP + FP + FN)\n",
    "    \"\"\"\n",
    "    return tp / (tp + fp + fn + eps)\n",
    "\n",
    "def dice_score(tp, fp, fn, eps=1e-7):\n",
    "    \"\"\"\n",
    "    Coeficiente de Dice = 2*TP / (2*TP + FP + FN)\n",
    "    \"\"\"\n",
    "    return 2.0 * tp / (2.0 * tp + fp + fn + eps)\n",
    "\n",
    "def precision_score(tp, fp, fn, tn, eps=1e-7):\n",
    "    \"\"\"\n",
    "    Precision = TP / (TP + FP)\n",
    "    \"\"\"\n",
    "    return tp / (tp + fp + eps)\n",
    "\n",
    "def recall_score(tp, fp, fn, tn, eps=1e-7):\n",
    "    \"\"\"\n",
    "    Recall / Sensibilidad = TP / (TP + FN)\n",
    "    \"\"\"\n",
    "    return tp / (tp + fn + eps)\n",
    "\n",
    "def specificity_score(tp, fp, fn, tn, eps=1e-7):\n",
    "    \"\"\"\n",
    "    Especificidad = TN / (TN + FP)\n",
    "    \"\"\"\n",
    "    return tn / (tn + fp + eps)\n",
    "\n",
    "def balanced_accuracy(tp, fp, fn, tn, eps=1e-7):\n",
    "    \"\"\"\n",
    "    Balanced Accuracy = (Recall + Specificity) / 2\n",
    "    \"\"\"\n",
    "    rec = recall_score(tp, fp, fn, tn, eps)\n",
    "    spec = specificity_score(tp, fp, fn, tn, eps)\n",
    "    return 0.5 * (rec + spec)\n"
