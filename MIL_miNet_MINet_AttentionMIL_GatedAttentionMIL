    "\n",
    "train_ds = AudioBagsMEL28(X_target_train, y_target_train, bag_size=10, device=device)\n",
    "test_ds  = AudioBagsMEL28(X_target_test,  y_target_test,  bag_size=10, device=device)\n",
    "\n",
    "train_loader = DataLoader(train_ds, batch_size=1, shuffle=True)\n",
    "test_loader  = DataLoader(test_ds, batch_size=1, shuffle=False)\n",
    "\n",
    "model = AttentionMIL(d=128).to(device)\n",
    "opt = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
    "\n",
    "for epoch in range(200):\n",
    "    acc, loss, acc_test, loss_test = train_epoch(\n",
    "        model, train_loader, test_loader, opt,\n",
    "        device=device,\n",
    "        top_k_ratio=0.4,\n",
    "        lambda_topk=0.0\n",
    "    )\n",
    "    print(f\"Epoch {epoch}: acc={acc:.3f}, loss={loss:.3f}, \"\n",
    "          f\"acc_test={acc_test:.3f}, loss_test={loss_test:.3f}\")\n",
    "\n"
