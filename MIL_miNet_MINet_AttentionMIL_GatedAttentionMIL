    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import librosa\n",
    "\n",
    "def carga_etiquetas_audio_preprocesadas(base_path: str, sr: int = 16000, seg_len: float = 1.0):\n",
    "    train = pd.read_csv(os.path.join(base_path, \"train_split_Depression_AVEC2017.csv\"),\n",
    "                        index_col=\"Participant_ID\")\n",
    "    dev   = pd.read_csv(os.path.join(base_path, \"dev_split_Depression_AVEC2017.csv\"),\n",
    "                        index_col=\"Participant_ID\")\n",
    "\n",
    "    rutas_audio_train, etiqueta_train = [], []\n",
    "    for pid in train.index:\n",
    "        pid_str = str(pid)  # <-- FIX: asegurar string\n",
    "\n",
    "        ruta_texto = os.path.join(\n",
    "            \"/kaggle/input/notebooks/alejopatio/carga-datos-bags-instances/exports/train\",\n",
    "            f\"bestidx_subset_{pid_str}_P_cosine.csv\"\n",
    "        )\n",
    "        df = pd.read_csv(ruta_texto)\n",
    "\n",
    "        dir_audios = os.path.join(base_path, f\"{pid_str}_P\", f\"{pid_str}_AUDIO.wav\")\n",
    "        print(dir_audios)\n",
    "\n",
    "        y, _sr = librosa.load(dir_audios, sr=sr)\n",
    "\n",
    "        audios = []\n",
    "        for i in range(df.shape[0]):\n",
    "            start_s = float(df.loc[i, \"start_patient\"])\n",
    "            end_s   = float(df.loc[i, \"end_patient\"])\n",
    "\n",
    "            start_time = int(max(0.0, start_s - seg_len) * sr)\n",
    "            stop_time  = int(min(len(y) / sr, end_s + seg_len) * sr)\n",
    "\n",
    "            audios.append(y[start_time:stop_time])\n",
    "\n",
    "        rutas_audio_train.append(audios)\n",
    "        etiqueta_train.append(int(train.loc[pid, \"PHQ8_Binary\"]))\n",
    "\n",
    "    rutas_audio_test, etiqueta_test = [], []\n",
    "    for pid in dev.index:\n",
    "        try:\n",
    "            pid_str = str(pid)  # <-- FIX: asegurar string\n",
    "    \n",
    "            ruta_texto = os.path.join(\n",
    "                \"/kaggle/input/notebooks/alejopatio/carga-datos-bags-instances/exports/test\",\n",
    "                f\"bestidx_subset_{pid_str}_P_cosine.csv\"\n",
    "            )\n",
    "            df = pd.read_csv(ruta_texto)\n",
    "    \n",
    "            dir_audios = os.path.join(base_path, f\"{pid_str}_P\", f\"{pid_str}_AUDIO.wav\")\n",
    "            print(dir_audios)\n",
    "    \n",
    "            y, _sr = librosa.load(dir_audios, sr=sr)\n",
    "    \n",
    "            audios = []\n",
    "            for i in range(df.shape[0]):\n",
    "                \n",
    "                start_s = float(df.loc[i, \"start_patient\"])\n",
    "                end_s   = float(df.loc[i, \"end_patient\"])\n",
    "    \n",
    "                start_time = int(max(0.0, start_s - seg_len) * sr)\n",
    "                stop_time  = int(min(len(y) / sr, end_s + seg_len) * sr)\n",
    "    \n",
    "                audios.append(y[start_time:stop_time])\n",
    "                \n",
    "    \n",
    "            rutas_audio_test.append(audios)\n",
    "            etiqueta_test.append(int(dev.loc[pid, \"PHQ8_Binary\"]))  # <-- FIX: usar dev\n",
    "        except: continue\n",
    "\n",
    "    return rutas_audio_train, np.asarray(etiqueta_train), rutas_audio_test, np.asarray(etiqueta_test)\n",
    "\n",
    "path = \"/kaggle/input/daic-woz/DAIC-WOZ\"\n",
    "X_audio_preprocess_train, y_audio_preprocess_train, X_audio_preprocess_test, y_audio_preprocess_test = \\\n",
    "    carga_etiquetas_audio_preprocesadas(path)\n",
    "\n",
    "print( len(X_audio_preprocess_train), y_audio_preprocess_train.shape)\n",
    "print( len(X_audio_preprocess_test), y_audio_preprocess_test.shape)"
