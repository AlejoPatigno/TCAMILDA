    "        A = F.softmax(A, dim=1)                   # softmax sobre instancias\n",
    "    \n",
    "        Z = torch.mm(A, H)                        # [B,M]\n",
    "        Y_prob = self.classifier(Z)               # [B,1]\n",
    "        Y_hat  = (Y_prob >= 0.5).float()\n",
    "    \n",
    "        return Y_prob, Y_hat, A\n",
    "\n",
    "\n",
    "\n",
    "    # AUXILIARY METHODS\n",
