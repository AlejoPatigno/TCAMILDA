    "\n",
    "def plot_umap_instancelevel(\n",
    "    ax,\n",
    "    Z,\n",
    "    y,\n",
    "    bag_ids,\n",
    "    title,\n",
    "    subject_ids=None,        # id por instancia (mismo largo que Z). Si no, usa bag_ids.\n",
    "    kde_bw=None,             # None -> Scott; o float (p.ej. 0.3)\n",
    "    kde_gridsize=200,\n",
    "    kde_alpha=0.20,\n",
    "    annotate=True,\n",
    "    annot_fontsize=7,\n",
    "    annot_alpha=0.90,\n",
    "    point_size=14,\n",
    "    point_alpha=0.85,\n",
    "    xlim=None,\n",
    "    ylim=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Instance-level:\n",
    "      - KDE 2D por clase (relleno + contornos)\n",
    "      - Scatter con marcador por clase y color por bag-id (como tu función)\n",
    "      - Etiqueta cada punto con el número/id de sujeto (subject_ids) o, por defecto, bag_id\n",
    "    \"\"\"\n",
    "\n",
    "    Z = np.asarray(Z)\n",
    "    y = np.asarray(y).reshape(-1)\n",
    "    bag_ids = np.asarray(bag_ids).reshape(-1)\n",
    "\n",
    "    if Z.shape[0] != y.shape[0] or Z.shape[0] != bag_ids.shape[0]:\n",
    "        raise ValueError(\n",
    "            f\"Incompatibilidad: Z={Z.shape}, y={y.shape}, bag_ids={bag_ids.shape}.\"\n",
    "        )\n",
    "\n",
    "    n = Z.shape[0]\n",
    "    if subject_ids is None:\n",
    "        subject_ids = bag_ids\n",
    "    subject_ids = np.asarray(subject_ids).reshape(-1)\n",
    "    if subject_ids.shape[0] != n:\n",
    "        raise ValueError(f\"subject_ids tiene {subject_ids.shape[0]} pero Z tiene {n}.\")\n",
    "\n",
    "    # ----------------------------\n",
    "    # 1) KDE por clase (2D)\n",
    "    # ----------------------------\n",
    "    x = Z[:, 0]\n",
    "    y2 = Z[:, 1]\n",
    "    pad_x = 0.05 * (x.max() - x.min() + 1e-9)\n",
    "    pad_y = 0.05 * (y2.max() - y2.min() + 1e-9)\n",
    "    xmin, xmax = x.min() - pad_x, x.max() + pad_x\n",
    "    ymin, ymax = y2.min() - pad_y, y2.max() + pad_y\n",
    "\n",
    "    xx, yy = np.meshgrid(\n",
    "        np.linspace(xmin, xmax, kde_gridsize),\n",
    "        np.linspace(ymin, ymax, kde_gridsize),\n",
    "    )\n",
    "    grid = np.vstack([xx.ravel(), yy.ravel()])\n",
    "\n",
    "    class_vals = np.unique(y)\n",
    "    for cls in class_vals:\n",
    "        m = (y == cls)\n",
    "        Zc = Z[m]\n",
    "\n",
    "        # KDE 2D estable: ideal >= 3 puntos no colineales\n",
    "        if Zc.shape[0] >= 3:\n",
    "            kde = gaussian_kde(Zc.T, bw_method=kde_bw)\n",
    "            zz = kde(grid).reshape(xx.shape)\n",
    "\n",
    "            # normalizar 0-1 para evitar escalas raras entre clases\n",
    "            zz = (zz - zz.min()) / (zz.max() - zz.min() + 1e-12)\n",
    "\n",
    "            ax.contourf(xx, yy, zz, levels=12, alpha=kde_alpha)\n",
    "            ax.contour(xx, yy, zz, levels=6, linewidths=0.8, alpha=min(0.85, kde_alpha + 0.25))\n",
    "\n",
    "    # ----------------------------\n",
    "    # 2) Scatter por clase (marcador) y color por bag-id\n",
    "    # ----------------------------\n",
    "    unique_bags = np.unique(bag_ids)\n",
    "    n_bags = len(unique_bags)\n",
    "    cmap = plt.get_cmap(\"tab20\" if n_bags <= 20 else \"hsv\")\n",
    "    bag_to_idx = {b: i for i, b in enumerate(unique_bags)}\n",
    "\n",
    "    for cls, marker, name in [(0, \"^\", \"Clase 0 (triángulos)\"), (1, \"o\", \"Clase 1 (bolas)\")]:\n",
    "        m = (y == cls)\n",
    "        if not np.any(m):\n",
    "            continue\n",
    "\n",
    "        color_vals = np.array([bag_to_idx[b] for b in bag_ids[m]], dtype=np.float32)\n",
    "        color_vals_norm = color_vals / max(n_bags - 1, 1)\n",
    "\n",
    "        ax.scatter(\n",
    "            Z[m, 0], Z[m, 1],\n",
    "            c=color_vals_norm,\n",
    "            cmap=cmap,\n",
    "            s=point_size,\n",
    "            alpha=point_alpha,\n",
    "            marker=marker,\n",
    "            linewidths=0.0,\n",
    "            label=name,\n",
    "        )\n",
    "\n",
    "    # ----------------------------\n",
    "    # 3) Anotar cada instancia con subject_id (o bag_id)\n",
    "    # ----------------------------\n",
    "    if annotate:\n",
    "        dx = 0.004 * (xmax - xmin + 1e-9)\n",
    "        dy = 0.004 * (ymax - ymin + 1e-9)\n",
    "        for i in range(n):\n",
    "            ax.text(\n",
    "                Z[i, 0] + dx,\n",
    "                Z[i, 1] + dy,\n",
    "                str(subject_ids[i]),\n",
    "                fontsize=annot_fontsize,\n",
    "                alpha=annot_alpha,\n",
    "            )\n",
    "\n",
    "    # ----------------------------\n",
    "    # 4) Estética final\n",
    "    # ----------------------------\n",
    "    ax.set_title(title)\n",
    "    ax.set_xlabel(\"UMAP-1\")\n",
    "    ax.set_ylabel(\"UMAP-2\")\n",
    "    ax.set_xlim(*(xlim if xlim is not None else (xmin, xmax)))\n",
    "    ax.set_ylim(*(ylim if ylim is not None else (ymin, ymax)))\n",
    "    ax.grid(True, alpha=0.25)\n",
    "    ax.legend(loc=\"best\", fontsize=8)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# FUNCIÓN PRINCIPAL: construye la figura 2x2\n",
    "# ============================================================\n",
    "def plot_umap_grid_2x2(\n",
    "    loader_mel: DataLoader,\n",
    "    loader_emb: DataLoader,\n",
    "    max_bags: int | None = None,\n",
    "    max_instances_total: int | None = None,\n",
    "    umap_kwargs=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Columnas:\n",
    "      col 0: MEL spectrograms (AudioBagsMEL28)\n",
    "      col 1: Embedded (AudioBagsEmbedded)\n",
    "    Filas:\n",
    "      fila 0: bag-level\n",
    "      fila 1: instance-level\n",
    "    \"\"\"\n",
    "    if umap_kwargs is None:\n",
    "        umap_kwargs = dict(n_neighbors=20, min_dist=0.05, metric=\"euclidean\", random_state=42)\n",
    "\n",
    "    # ---- MEL: bag-level + instance-level\n",
    "    X_mel_b, y_mel_b = extract_bag_level_matrix_any(loader_mel, max_bags=max_bags)\n",
    "    Z_mel_b = fit_umap(X_mel_b, **umap_kwargs)\n",
    "\n",
    "    X_mel_i, y_mel_i, bid_mel_i = extract_instance_level_matrix_any(\n",
    "        loader_mel, max_bags=max_bags, max_instances_total=max_instances_total\n",
    "    )\n",
    "    Z_mel_i = fit_umap(X_mel_i, **umap_kwargs)\n",
    "\n",
    "    # ---- EMB: bag-level + instance-level\n",
    "    X_emb_b, y_emb_b = extract_bag_level_matrix_any(loader_emb, max_bags=max_bags)\n",
    "    Z_emb_b = fit_umap(X_emb_b, **umap_kwargs)\n",
    "    # umap_kwargs['n_neighbors'] = umap_kwargs['n_neighbors'] // 10\n",
    "\n",
    "    X_emb_i, y_emb_i, bid_emb_i = extract_instance_level_matrix_any(\n",
    "        loader_emb, max_bags=max_bags, max_instances_total=max_instances_total\n",
    "    )\n",
    "    Z_emb_i = fit_umap(X_emb_i, **umap_kwargs)\n",
    "\n",
    "    # ---- Plot 2x2\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(14, 8))\n",
    "\n",
    "    plot_umap_baglevel(axes[0, 0], Z_mel_b, y_mel_b, \"MEL — Bag-level\")\n",
    "    plot_umap_baglevel(axes[0, 1], Z_emb_b, y_emb_b, \"Embedded — Bag-level\")\n",
    "\n",
    "    plot_umap_instancelevel(axes[1, 0], Z_mel_i, y_mel_i, bid_mel_i, \"MEL — Instance-level (color=bag)\")\n",
    "    plot_umap_instancelevel(axes[1, 1], Z_emb_i, y_emb_i, bid_emb_i, \"Embedded — Instance-level (color=bag)\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    return fig, axes\n",
    "\n",
