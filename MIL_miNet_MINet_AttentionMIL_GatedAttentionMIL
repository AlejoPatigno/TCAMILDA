    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "# X_target_train, X_target_test, y_target_train, y_target_test = train_test_split(X_target, y_target, test_size=0.2, shuffle=True, stratify= y_target)\n",
    "train_ds = AudioBagsMEL28(X_audio_preprocess_train, y_audio_preprocess_train, bag_size=10, device=\"cpu\")\n",
    "test_ds  = AudioBagsMEL28(X_audio_preprocess_test, y_audio_preprocess_test,  bag_size=10, device=\"cpu\")\n",
    "\n",
    "from torch.utils.data import DataLoader\n",
    "train_loader = DataLoader(train_ds, batch_size=1, shuffle=True)\n",
    "test_loader  = DataLoader(test_ds,  batch_size=1, shuffle=False)\n",
    "\n",
    "model = GatedAttention().to(device)   # o Attention()\n",
    "opt = torch.optim.Adam(model.parameters(), lr=1e-4)\n",
    "\n",
    "t1 = time.time()\n",
    "best_acc = 0.0\n",
    "\n",
    "for epoch in range(200):\n",
    "    acc, loss, acc_test, loss_test = train_epoch(\n",
    "        model, train_loader, test_loader, opt,\n",
    "        device=device,\n",
    "        thr=0.5\n",
    "    )\n",
    "    metrics = evaluate_metrics(model, test_loader, device=device, thr=0.5)\n",
    "\n",
    "    print(\n",
    "        f\"Epoch {epoch}: acc={acc:.3f}, loss={loss:.3f}, \"\n",
    "        f\"acc_test={metrics['accuracy']:.3f}, loss_test={metrics['loss_mean']:.3f}, \"\n",
    "        f\"precision_test={metrics['precision_macro']:.3f}, \"\n",
    "        f\"recall_test={metrics['recall_macro']:.3f}, \"\n",
    "        f\"f1_test={metrics['f1_macro']:.3f}, \"\n",
    "        f\"uar_test={metrics['uar']:.3f}\"\n",
    "    )\n",
    "\n",
    "    if acc_test > best_acc:\n",
    "        best_acc = acc_test\n",
    "        print(f\"best accuracy = {best_acc:.3f}\")\n",
    "\n",
    "t2 = time.time()\n",
    "print(f\"best accuracy = {best_acc:.3f}, ran in {t2 - t1:.2f} s\")"
