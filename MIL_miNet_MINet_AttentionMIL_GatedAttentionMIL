    "import time\n",
    "import numpy as np\n",
    "import torch\n",
    "from torch.utils.data import DataLoader, Subset\n",
    "from sklearn.model_selection import StratifiedKFold, KFold\n",
    "import time\n",
    "\n",
    "# reproducibility\n",
    "SEED = 42\n",
    "torch.manual_seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "\n",
    "\n",
    "import numpy as np\n",
    "import torch\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    f1_score,\n",
    "    confusion_matrix\n",
    ")\n",
    "\n",
    "def evaluate_metrics(model, loader, device, num_classes=2):\n",
    "    \"\"\"\n",
    "    Computes:\n",
    "        - Accuracy\n",
    "        - Precision (macro)\n",
    "        - Recall (macro)\n",
    "        - F1-score (macro)\n",
    "        - UAR (macro recall)\n",
    "        - Confusion matrix\n",
    "\n",
    "    Supports binary and multi-class classification.\n",
    "    \"\"\"\n",
    "\n",
    "    model.eval()\n",
    "    y_true = []\n",
    "    y_pred = []\n",
    "    losses = []\n",
    "\n",
    "    if num_classes == 2:\n",
    "        criterion = torch.nn.BCEWithLogitsLoss()\n",
    "    else:\n",
    "        criterion = torch.nn.CrossEntropyLoss()\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for batch in loader:\n",
    "            X, y = batch\n",
    "            X = X[0] .to(device)\n",
    "            y = y.to(device)\n",
    "\n",
    "            logits, alpha, inst_logits = model(X)\n",
    "\n",
    "            if num_classes == 2:\n",
    "                logits = logits.view(-1)\n",
    "                loss = criterion(logits, y.float().view(-1))\n",
    "                probs = torch.sigmoid(logits)\n",
    "                preds = (probs >= 0.5).long()\n",
    "            else:\n",
    "                loss = criterion(logits, y)\n",
    "                preds = torch.argmax(logits, dim=1)\n",
    "\n",
    "            losses.append(loss.item())\n",
    "            y_true.extend(y.view(-1).cpu().numpy())\n",
    "            y_pred.extend(preds.view(-1).cpu().numpy())\n",
    "\n",
    "    y_true = np.array(y_true)\n",
    "    y_pred = np.array(y_pred)\n",
    "\n",
    "    acc = accuracy_score(y_true, y_pred)\n",
    "    precision = precision_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "    recall = recall_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "    f1 = f1_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "    uar = recall  # UAR == macro recall\n",
    "\n",
    "    cm = confusion_matrix(y_true, y_pred)\n",
    "\n",
    "    return {\n",
    "        \"accuracy\": acc,\n",
    "        \"precision_macro\": precision,\n",
    "        \"recall_macro\": recall,\n",
    "        \"f1_macro\": f1,\n",
    "        \"uar\": uar,\n",
    "        \"loss_mean\": float(np.mean(losses)),\n",
    "        \"confusion_matrix\": cm\n",
    "    }\n",
    "\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "# X_target_train, X_target_test, y_target_train, y_target_test = train_test_split(X_target, y_target, test_size=0.2, shuffle=True, stratify= y_target)\n",
    "\n",
    "train_ds = AudioBagsMEL28(X_audio_train, y_audio_train, bag_size=10, device=device)\n",
    "test_ds  = AudioBagsMEL28(X_audio_test, y_audio_test,  bag_size=10, device=device)\n",
    "\n",
    "train_loader = DataLoader(train_ds, batch_size=1, shuffle=True)\n",
    "test_loader  = DataLoader(test_ds, batch_size=1, shuffle=False)\n",
    "\n",
    "model = AttentionMIL(d=128).to(device)\n",
    "opt = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
    "\n",
    "t1 = time.time()\n",
    "best_recall = 0\n",
    "for epoch in range(200):\n",
    "    acc, loss, acc_test, loss_test = train_epoch(\n",
    "        model, train_loader, test_loader, opt,\n",
    "        device=device,\n",
    "        top_k_ratio=0.4,\n",
    "        lambda_topk=0.0\n",
    "    )\n",
    "    metrics = evaluate_metrics(model, test_loader, device)\n",
    "    \n",
    "    print(f\"Epoch {epoch}: acc={acc:.3f}, loss={loss:.3f}, \"\n",
    "          f\"acc_test={metrics[\"accuracy\"]:.3f}, loss_test={metrics[\"loss_mean\"]:.3f}, precision_test = {metrics[\"precision_macro\"]:.3f}, \"\n",
    "            f\"recall_test = {metrics[\"recall_macro\"]:.3f}, f1_test = {metrics[\"f1_macro\"]:.3f}, uar_test = {metrics[\"uar\"]:.3f}\")\n",
    "    if metrics[\"recall_macro\"]> best_recall:\n",
    "        best_recall = acc_test\n",
    "        print(f\"best recall = {best_recall}\")\n",
    "t2 = time.time()\n",
    "print(f\"best recall = {best_recall}, ran in {t2-t1}\")\n"
   ]
