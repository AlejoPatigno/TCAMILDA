    "            pass\n",
    "\n",
    "    # --- Scatter por clase\n",
    "    for c in class_vals:\n",
    "        mask = (y == c)\n",
    "        ax.scatter(\n",
    "            Z[mask, 0],\n",
    "            Z[mask, 1],\n",
    "            s=point_size,\n",
    "            alpha=point_alpha,\n",
