    "\n",
    "        self.to_db = torchaudio.transforms.AmplitudeToDB(stype=\"power\").to(device)\n",
    "        self.normalize_per_instance = normalize_per_instance\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.X)\n",
    "\n",
    "    def _load_audio(self, a):\n",
    "        \"\"\"\n",
    "        Acepta:\n",
    "        - str/bytes: ruta\n",
    "        - np.ndarray / torch.Tensor: waveform\n",
    "        - dict: con llaves típicas ('audio','wav','waveform','y') o ('path','ruta')\n",
    "        Devuelve wav mono [1,T] en self.device\n",
    "        \"\"\"\n",
    "        # --- NUEVO: dict -> extraer audio o path ---\n",
    "        if isinstance(a, dict):\n",
    "            if \"path\" in a:\n",
    "                a = a[\"path\"]\n",
    "            elif \"ruta\" in a:\n",
    "                a = a[\"ruta\"]\n",
    "            else:\n",
    "                for k in (\"audio\", \"wav\", \"waveform\", \"y\"):\n",
