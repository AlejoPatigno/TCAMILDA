    "from __future__ import print_function\n",
    "\n",
    "import argparse\n",
    "\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.optim as optim\n",
    "import torch.utils.data as data_utils\n",
    "from torch.autograd import Variable\n",
    "\n",
    "import time\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn.functional as F\n",
    "from sklearn.metrics import accuracy_score, precision_recall_fscore_support, recall_score\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1) Métricas bag-level (macro) sobre un loader (batch_size=1)\n",
    "# ------------------------------------------------------------\n",
    "@torch.no_grad()\n",
    "def evaluate_metrics(model, loader, device=\"cpu\", thr=0.5):\n",
    "    model.eval()\n",
    "    y_true, y_prob = [], []\n",
    "    losses = []\n",
    "\n",
    "    for x, y in loader:\n",
    "        x = x.to(device)                    # [1,K,1,28,28]\n",
    "        y = y.to(device).view(-1, 1)        # [1,1]\n",
    "\n",
    "        p, _, _ = model(x)                  # p: [1,1] (prob)\n",
    "        p = p.view(-1, 1)\n",
    "\n",
    "        # estabilidad numérica\n",
    "        p = torch.clamp(p, 1e-5, 1 - 1e-5)\n",
    "\n",
    "        loss = F.binary_cross_entropy(p, y)\n",
    "        losses.append(loss.item())\n",
    "\n",
    "        y_true.append(int(y.item()))\n",
    "        y_prob.append(float(p.item()))\n",
    "\n",
    "    y_true = np.asarray(y_true, dtype=int)\n",
    "    y_prob = np.asarray(y_prob, dtype=float)\n",
    "    y_pred = (y_prob >= thr).astype(int)\n",
    "\n",
    "    acc = float(accuracy_score(y_true, y_pred))\n",
    "    prec, rec, f1, _ = precision_recall_fscore_support(\n",
    "        y_true, y_pred, average=\"macro\", zero_division=0\n",
    "    )\n",
    "    uar = float(recall_score(y_true, y_pred, average=\"macro\", zero_division=0))\n",
    "\n",
    "    return {\n",
    "        \"accuracy\": acc,\n",
    "        \"loss_mean\": float(np.mean(losses)) if len(losses) else float(\"nan\"),\n",
    "        \"precision_macro\": float(prec),\n",
    "        \"recall_macro\": float(rec),\n",
    "        \"f1_macro\": float(f1),\n",
    "        \"uar\": uar,\n",
    "    }\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2) Train/Eval por epoch (estilo AttentionMIL)\n",
    "# ------------------------------------------------------------\n",
    "def train_epoch(model, train_loader, test_loader, opt, device=\"cpu\", thr=0.5):\n",
    "    model.train()\n",
    "    y_true_tr, y_prob_tr = [], []\n",
    "    losses_tr = []\n",
    "\n",
    "    for x, y in train_loader:\n",
    "        x = x.to(device)\n",
    "        y = y.to(device).view(-1, 1)\n",
    "\n",
    "        p, _, _ = model(x)\n",
    "        p = p.view(-1, 1)\n",
    "        p = torch.clamp(p, 1e-5, 1 - 1e-5)\n",
    "\n",
    "        loss = F.binary_cross_entropy(p, y)\n",
    "\n",
    "        opt.zero_grad()\n",
    "        loss.backward()\n",
    "        opt.step()\n",
    "\n",
    "        losses_tr.append(loss.item())\n",
    "        y_true_tr.append(int(y.item()))\n",
    "        y_prob_tr.append(float(p.detach().item()))\n",
    "\n",
    "    # train acc (bag-level)\n",
    "    y_true_tr = np.asarray(y_true_tr, dtype=int)\n",
    "    y_prob_tr = np.asarray(y_prob_tr, dtype=float)\n",
    "    y_pred_tr = (y_prob_tr >= thr).astype(int)\n",
    "    acc_tr = float(accuracy_score(y_true_tr, y_pred_tr))\n",
    "    loss_tr = float(np.mean(losses_tr)) if len(losses_tr) else float(\"nan\")\n",
    "\n",
    "    # eval simple (acc_test y loss_test)\n",
    "    metrics_test = evaluate_metrics(model, test_loader, device=device, thr=thr)\n",
    "    acc_te = metrics_test[\"accuracy\"]\n",
    "    loss_te = metrics_test[\"loss_mean\"]\n",
    "\n",
    "    return acc_tr, loss_tr, acc_te, loss_te\n",
    "\n",
    "\n",
    "\n",
    "# Training settings\n",
    "parser = argparse.ArgumentParser(description='PyTorch MNIST bags Example')\n",
    "parser.add_argument('--epochs', type=int, default=20, metavar='N',\n",
